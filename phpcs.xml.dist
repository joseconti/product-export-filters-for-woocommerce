<?xml version="1.0"?>
<ruleset name="Export Filters for WooCommerce">
	<description>Coding standard for Export Filters for WooCommerce.</description>

	<file>export-filters-for-woocommerce.php</file>
	<file>includes</file>
	<file>uninstall.php</file>

	<arg value="sp"/>
	<arg name="basepath" value="./"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<config name="minimum_supported_wp_version" value="6.4"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="export-filters-for-woocommerce"/>
			</property>
		</properties>
	</rule>
</ruleset>
