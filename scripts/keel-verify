#!/usr/bin/env bash
# Export Filters for WooCommerce — release linter.
# Mechanical checks: [E] code-map paths exist, PHP lints, coding standard
# passes, version touchpoints agree, .gitignore hygiene, no unminified
# expectation mismatch (n/a — no build pipeline, D-010).
# Exit 0 = pass. Exit 1 = at least one check failed (see FAIL lines).

set -u
cd "$(dirname "$0")/.."

FAILED=0
pass() { echo "PASS: $1"; }
fail() { echo "FAIL: $1"; FAILED=1; }

# --- [E] code-map paths (docs/03-technical-plan.md) -------------------------
for f in \
	export-filters-for-woocommerce.php \
	includes/class-efwc-date-filter.php \
	uninstall.php \
	tests/bootstrap.php \
	tests/unit/test-clean-date.php \
	tests/unit/test-query-args.php \
	tests/e2e/export-date-filter.spec.js \
	.wp-env.json \
	tests/seed/seed-products.php \
	.distignore \
	readme.txt \
	docs/PROGRESS.md \
	docs/decisions.md \
	docs/lessons-learned.md
do
	if [ -f "$f" ]; then
		pass "[E] path exists: $f"
	else
		fail "[E] path missing: $f"
	fi
done

# --- PHP syntax -------------------------------------------------------------
PHP_BIN="${PHP_BIN:-php}"
for f in export-filters-for-woocommerce.php includes/*.php uninstall.php tests/bootstrap.php tests/unit/*.php tests/seed/*.php; do
	if $PHP_BIN -l "$f" >/dev/null 2>&1; then
		pass "php -l: $f"
	else
		fail "php -l: $f"
	fi
done

# --- Coding standard (optional: only if vendor/bin/phpcs is installed) ------
if [ -x vendor/bin/phpcs ]; then
	if vendor/bin/phpcs --standard=phpcs.xml.dist -q >/tmp/efwc-phpcs.log 2>&1; then
		pass "phpcs --standard=phpcs.xml.dist"
	else
		fail "phpcs --standard=phpcs.xml.dist (see /tmp/efwc-phpcs.log)"
	fi
else
	echo "SKIP: phpcs not installed (run 'composer install' first) — not yet applicable"
fi

# --- Version touchpoints agree ----------------------------------------------
PLUGIN_VERSION=$(grep -oE "Version:\s*[0-9]+\.[0-9]+\.[0-9]+" export-filters-for-woocommerce.php | grep -oE "[0-9]+\.[0-9]+\.[0-9]+")
CONST_VERSION=$(grep -oE "EFWC_VERSION', '[0-9]+\.[0-9]+\.[0-9]+" export-filters-for-woocommerce.php | grep -oE "[0-9]+\.[0-9]+\.[0-9]+")
README_STABLE=$(grep -oE "Stable tag:\s*[0-9]+\.[0-9]+\.[0-9]+" readme.txt | grep -oE "[0-9]+\.[0-9]+\.[0-9]+")

if [ "$PLUGIN_VERSION" = "$CONST_VERSION" ] && [ "$PLUGIN_VERSION" = "$README_STABLE" ] && [ -n "$PLUGIN_VERSION" ]; then
	pass "version touchpoints agree ($PLUGIN_VERSION)"
else
	fail "version touchpoints disagree: header=$PLUGIN_VERSION const=$CONST_VERSION readme=$README_STABLE"
fi

# --- .gitignore hygiene ------------------------------------------------------
for entry in node_modules/ vendor/ test-results/ playwright-report/ ".claude/settings.local.json" ".keel-update-check" "docs/continuation-prompt.md"; do
	if grep -qF -- "$entry" .gitignore 2>/dev/null; then
		pass ".gitignore has: $entry"
	else
		fail ".gitignore missing: $entry"
	fi
done

# --- No .mo committed (generated artifact, [G] per code map) ---------------
if git ls-files | grep -q '\.mo$'; then
	fail "a compiled .mo file is tracked in git — .mo is [G] (generated), should stay gitignored"
else
	pass "no .mo file tracked in git"
fi

echo
if [ "$FAILED" -eq 0 ]; then
	echo "VERDICT: PASS"
	exit 0
else
	echo "VERDICT: FAIL"
	exit 1
fi
